<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microsoft.AspNetCore.OpenApi removed: it was pinned to 8.0.0 on a
         net10.0 project (never bumped) and unused — Swashbuckle below is
         what actually generates/serves the OpenAPI doc and Swagger UI. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Was 6.5.0, which predates .NET 9/10 support. NuGet was unreachable in
         the sandbox this was written in — run `dotnet restore` and bump this
         if the exact patch version below isn't the latest 7.x/8.x available. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Adopaws.Application\Adopaws.Application.csproj" />
    <ProjectReference Include="..\Adopaws.Infrastructure\Adopaws.Infrastructure.csproj" />
  </ItemGroup>
</Project>
